NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiktok_carousel_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# External APIs (optional — when empty, backend returns mock payloads with mock:true so demo runs end-to-end without keys)
NOTION_API_KEY=
OPENAI_API_KEY=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_API_KEY=your_tiktok_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Optional: when OPENAI_API_KEY / NOTION_API_KEY / TIKTOK_CLIENT_KEY empty, /ai and /tiktok respond 201/200 with mock carousel/account + mock:true banner

# Logging
LOG_LEVEL=debug
